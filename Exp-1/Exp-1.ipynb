      "source": [
        "import ipywidgets as widgets\n",
        "from IPython.display import display\n",
        "\n",
        "slider = widgets.IntSlider(value=40, min=0, max=100, step=1,\n",
        "description='Value:')\n",
        "output = widgets.Output()\n",
        "display(slider)\n",
        "\n",
        "print(f'The current slider value is {slider.value}')"
      ]
